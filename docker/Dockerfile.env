# syntax=docker/dockerfile:1.7

FROM mambaorg/micromamba:1.5.10-focal AS micromamba_source

FROM nvidia/cuda:11.3.1-devel-ubuntu20.04

USER root
SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    MAMBA_ROOT_PREFIX=/opt/conda \
    PATH=/opt/conda/bin:/usr/local/cuda/bin:${PATH} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/opt/.cache/huggingface \
    TRANSFORMERS_CACHE=/opt/.cache/huggingface \
    XDG_CACHE_HOME=/opt/.cache \
    TORCH_HOME=/opt/.cache/torch \
    CUDA_HOME=/usr/local/cuda \
    LD_LIBRARY_PATH=/opt/conda/lib:/usr/local/cuda/lib64:${LD_LIBRARY_PATH} \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=all

WORKDIR /opt

# System libraries for Habitat-Sim, OpenGL/EGL, video writing, and ROS builds.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git wget ca-certificates ffmpeg build-essential gcc-10 g++-10 ninja-build \
      libglib2.0-0 libsm6 libxext6 libxrender1 libgomp1 \
      libglvnd0 libglvnd-dev libgl1 libglx0 libegl1 libegl-dev \
      libopengl0 libgles2 patchelf gosu \
    && rm -rf /var/lib/apt/lists/*

# Install micromamba into /opt/conda.
COPY --from=micromamba_source /bin/micromamba /usr/local/bin/micromamba
RUN micromamba shell init -s bash -r /opt/conda

# NVIDIA EGL vendor config for headless rendering.
RUN mkdir -p /usr/share/glvnd/egl_vendor.d && \
    echo '{"file_format_version":"1.0.0","ICD":{"library_path":"libEGL_nvidia.so.0"}}' \
      > /usr/share/glvnd/egl_vendor.d/10_nvidia.json

# OVON uses the Habitat 0.2.3 stack.
# Python stays at 3.9 because RoboStack ROS Humble rclpy is needed.
#
# Keep cudatoolkit=11.3 even though the base image has CUDA.
# Conda PyTorch expects compatible CUDA runtime libraries in /opt/conda/lib.
RUN --mount=type=cache,target=/opt/conda/pkgs \
    --mount=type=cache,target=/root/.cache \
    micromamba install -y -n base \
      -c pytorch -c conda-forge -c robostack-humble \
      python=3.9 "cmake>=3.22" pip \
      pytorch=1.12.1 torchvision=0.13.1 cudatoolkit=11.3 \
      "mkl<2024" \
      ros-humble-rclpy \
      ros-humble-std-msgs \
      ros-humble-sensor-msgs \
      ros-humble-rmw-cyclonedds-cpp \
      ros-humble-rosidl-default-generators \
      ros-humble-rosidl-default-runtime \
      colcon-common-extensions \
      libstdcxx-ng libgcc-ng \
    && micromamba clean --index-cache --yes

RUN pip install --upgrade "pip<24" "setuptools<68" "wheel<0.42"

RUN python -c "import torch; print('torch:', torch.__version__); print('cuda available:', torch.cuda.is_available()); print('torch cuda:', torch.version.cuda)" && \
    nvcc --version

RUN pip install \
      "attrs" "gitpython" "imageio" "imageio-ffmpeg" "matplotlib" \
      "numba<0.61" "numpy-quaternion" "pillow" "scipy<1.12" "tqdm"

ENV CC=/usr/bin/gcc-10 \
    CXX=/usr/bin/g++-10 \
    CUDAHOSTCXX=/usr/bin/g++-10

RUN micromamba install -y -n base habitat-sim=0.2.4 headless withbullet pytorch=1.12.1  cudatoolkit=11.3 \
  -c pytorch -c nvidia -c conda-forge -c aihabitat -y

RUN git clone --single-branch -b v0.2.4 --depth 1 https://github.com/facebookresearch/habitat-lab.git /opt/habitat-lab && \
    pip install -e /opt/habitat-lab/habitat-lab && \
    pip install -e /opt/habitat-lab/habitat-baselines

COPY envs/ovon /opt/ovon
RUN pip install -e /opt/ovon && \
    pip install git+https://github.com/naokiyokoyama/frontier_exploration.git

RUN pip install \
      "ftfy" "regex" "GPUtil" "trimesh" "seaborn" "timm" \
      "scikit-learn" "einops" "transformers==4.49.0" "protobuf==3.20.1" \
      "opencv-python==4.5.5.64" \
      git+https://github.com/openai/CLIP.git

RUN git clone --depth 1 https://github.com/facebookresearch/eai-vc.git /opt/eai-vc && \
    pip install -e /opt/eai-vc/vc_models

# Habitat-Baselines 0.2.x imports old TensorBoard protobuf stubs that are not
# compatible with protobuf 4+.
RUN pip install --force-reinstall "protobuf==3.20.1" && \
    python -c "import google.protobuf; assert google.protobuf.__version__ == '3.20.1'"

ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    AMENT_PREFIX_PATH=/opt/conda \
    COLCON_PREFIX_PATH=/opt/conda \
    CMAKE_PREFIX_PATH=/opt/conda \
    ROS_DISTRO=humble \
    ROS_VERSION=2 \
    ROS_PYTHON_VERSION=3

COPY agents/utils/ros_msgs /opt/ros2_ws/src/ros_msgs
RUN /bin/bash -c "cd /opt/ros2_ws && \
    colcon build --packages-select ros_msgs && \
    echo 'source /opt/ros2_ws/install/setup.bash' >> /etc/bash.bashrc"

COPY agents/utils/ros_helpers.py    /opt/rt_ovn/utils/ros_helpers.py
COPY agents/utils/video_recorder.py /opt/rt_ovn/utils/video_recorder.py
COPY agents/utils/cyclonedds.xml    /opt/rt_ovn/utils/cyclonedds.xml
COPY envs/async_ui.py              /opt/rt_ovn/async_ui.py
COPY envs/config /opt/rt_ovn/env_config

ENV PYTHONPATH=/opt/rt_ovn:/opt/rt_ovn/utils:/opt/ovon:/opt/vlfm

WORKDIR /opt

COPY agents/utils/entrypoint.sh /opt/entrypoint.sh
RUN chmod 755 /opt/entrypoint.sh

ENTRYPOINT ["/opt/entrypoint.sh"]
CMD ["/bin/bash"]
