# syntax=docker/dockerfile:1.7

FROM mambaorg/micromamba:1.5.10-focal AS micromamba_source

# Jetson AGX Thor (JetPack 7 / L4T R38) is a CUDA 13, ARM64 platform.  CUDA
# 11.3 and the old pytorch Conda channel do not contain Thor-compatible
# binaries.  This NVIDIA image is multi-arch, so the Dockerfile also remains
# buildable on an x86_64 CUDA 13 host.
FROM nvcr.io/nvidia/cuda:13.0.0-devel-ubuntu24.04

USER root
SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    MAMBA_ROOT_PREFIX=/opt/conda \
    PATH=/opt/conda/bin:/usr/local/cuda/bin:${PATH} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/opt/.cache/huggingface \
    TRANSFORMERS_CACHE=/opt/.cache/huggingface \
    XDG_CACHE_HOME=/opt/.cache \
    TORCH_HOME=/opt/.cache/torch \
    CUDA_HOME=/usr/local/cuda \
    LD_LIBRARY_PATH=/opt/conda/lib:/usr/local/cuda/lib64:${LD_LIBRARY_PATH} \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=all

WORKDIR /opt

# System libraries for Habitat-Sim, OpenGL/EGL, video writing, and ROS builds.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git wget ca-certificates ffmpeg build-essential gcc-12 g++-12 ninja-build \
      libglib2.0-0 libsm6 libxext6 libxrender1 libgomp1 \
      libglvnd0 libglvnd-dev libgl1 libglx0 libegl1 libegl-dev \
      libopengl0 libgles2 patchelf gosu \
    && rm -rf /var/lib/apt/lists/*

# Install micromamba into /opt/conda.
COPY --from=micromamba_source /bin/micromamba /usr/local/bin/micromamba
RUN micromamba shell init -s bash -r /opt/conda

# NVIDIA EGL vendor config for headless rendering.
RUN mkdir -p /usr/share/glvnd/egl_vendor.d && \
    echo '{"file_format_version":"1.0.0","ICD":{"library_path":"libEGL_nvidia.so.0"}}' \
      > /usr/share/glvnd/egl_vendor.d/10_nvidia.json

# OVON uses the Habitat 0.2.4 stack.  RoboStack Humble's current ARM64 builds
# use Python 3.11.  Keep CUDA/PyTorch out of Conda: its old pinned packages have
# no linux-aarch64 build, while PyTorch's cu130 index publishes ARM64 wheels.
RUN --mount=type=cache,target=/opt/conda/pkgs \
    --mount=type=cache,target=/root/.cache \
    micromamba install -y -n base \
      -c conda-forge -c robostack-humble \
      python=3.11 "cmake=3.27" pip \
      ros-humble-rclpy \
      ros-humble-std-msgs \
      ros-humble-sensor-msgs \
      ros-humble-rmw-cyclonedds-cpp \
      ros-humble-rosidl-default-generators \
      ros-humble-rosidl-default-runtime \
      colcon-common-extensions \
      libstdcxx-ng libgcc-ng \
    && micromamba clean --index-cache --yes

RUN pip install --upgrade "pip<24" "setuptools<68" "wheel<0.42" && \
    pip install \
      torch==2.10.0+cu130 torchvision==0.25.0+cu130 \
      --index-url https://download.pytorch.org/whl/cu130

RUN python -c "import torch; print('torch:', torch.__version__); print('cuda available:', torch.cuda.is_available()); print('torch cuda:', torch.version.cuda)" && \
    nvcc --version

RUN pip install \
      "attrs" "gitpython" "imageio" "imageio-ffmpeg" "matplotlib" \
      "numpy<2" "numba<0.61" "numpy-quaternion" "pillow" \
      "scipy<1.12" "tqdm"

ENV CC=/usr/bin/gcc-12 \
    CXX=/usr/bin/g++-12 \
    CUDAHOSTCXX=/usr/bin/g++-12

# aihabitat only publishes Habitat-Sim 0.2.4 for linux-64, not linux-aarch64.
# Build the same tag from source with the equivalent headless + Bullet options.
# CUDA interop is intentionally off; RGB/depth rendering still uses EGL on the
# NVIDIA GPU and this matches the feature set of the old headless Conda build.
RUN git clone --single-branch -b v0.2.4 --depth 1 \
      https://github.com/facebookresearch/habitat-sim.git /opt/habitat-sim && \
    cd /opt/habitat-sim && \
    git submodule update --init --recursive --depth 1 && \
    HEADLESS=1 WITH_BULLET=1 WITH_CUDA=0 \
      pip install . --no-build-isolation

RUN git clone --single-branch -b v0.2.4 --depth 1 https://github.com/facebookresearch/habitat-lab.git /opt/habitat-lab && \
    find /opt/habitat-lab -path '*/config/default_structured_configs.py' -exec \
      sed -Ei 's/^([[:space:]]+)([a-z0-9_]+): ([A-Za-z0-9_]+Config) = \3\(\)$/\1\2: \3 = field(default_factory=\3)/' {} + && \
    pip install -e /opt/habitat-lab/habitat-lab \
      "numpy<2" "scipy<1.12" "opencv-python==4.9.0.80" && \
    pip install -e /opt/habitat-lab/habitat-baselines

COPY envs/ovon /opt/ovon
RUN pip install -e /opt/ovon && \
    pip install git+https://github.com/naokiyokoyama/frontier_exploration.git

RUN pip install \
      "ftfy" "regex" "GPUtil" "trimesh" "seaborn" "timm" \
      "scikit-learn" "einops" "transformers==4.49.0" "protobuf==3.20.1" \
      "opencv-python==4.9.0.80" \
      git+https://github.com/openai/CLIP.git

RUN git clone --depth 1 https://github.com/facebookresearch/eai-vc.git /opt/eai-vc && \
    sed -i 's/"timm==0\.6\.11"/"timm>=1.0.28"/' /opt/eai-vc/vc_models/setup.py && \
    pip install "wandb<0.16" && \
    pip install -e /opt/eai-vc/vc_models

# Habitat-Baselines 0.2.x imports old TensorBoard protobuf stubs that are not
# compatible with protobuf 4+.
RUN pip install --force-reinstall "protobuf==3.20.1" && \
    python -c "import cv2, google.protobuf, habitat, habitat_baselines.config.default_structured_configs, habitat_sim, numpy, ovon.config, timm, torch, wandb; \
assert google.protobuf.__version__ == '3.20.1'; \
assert numpy.__version__.startswith('1.'); \
print('validated:', 'habitat-sim', habitat_sim.__version__, 'numpy', numpy.__version__, 'opencv', cv2.__version__, 'torch', torch.__version__, 'wandb', wandb.__version__)"

ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    AMENT_PREFIX_PATH=/opt/conda \
    COLCON_PREFIX_PATH=/opt/conda \
    CMAKE_PREFIX_PATH=/opt/conda \
    LD_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu/nvidia:/usr/lib/x86_64-linux-gnu:/opt/conda/lib:/usr/local/cuda/lib64:${LD_LIBRARY_PATH} \
    ROS_DISTRO=humble \
    ROS_VERSION=2 \
    ROS_PYTHON_VERSION=3

COPY agents/utils/ros_msgs /opt/ros2_ws/src/ros_msgs
RUN /bin/bash -c "cd /opt/ros2_ws && \
    colcon build --packages-select ros_msgs && \
    echo 'source /opt/ros2_ws/install/setup.bash' >> /etc/bash.bashrc"

COPY agents/utils/ros_helpers.py    /opt/rt_ovn/utils/ros_helpers.py
COPY agents/utils/video_recorder.py /opt/rt_ovn/utils/video_recorder.py
COPY agents/utils/cyclonedds.xml    /opt/rt_ovn/utils/cyclonedds.xml
COPY envs/async_ui.py              /opt/rt_ovn/async_ui.py
COPY envs/config /opt/rt_ovn/env_config

ENV PYTHONPATH=/opt/rt_ovn:/opt/rt_ovn/utils:/opt/ovon:/opt/vlfm

WORKDIR /opt

COPY agents/utils/entrypoint.sh /opt/entrypoint.sh
RUN chmod 755 /opt/entrypoint.sh

ENTRYPOINT ["/opt/entrypoint.sh"]
CMD ["/bin/bash"]
